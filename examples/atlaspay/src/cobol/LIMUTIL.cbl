       IDENTIFICATION DIVISION.
       PROGRAM-ID. LIMUTIL.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-CANDIDATE-LIMIT PIC 9(7)V99.

       LINKAGE SECTION.
       COPY AUTHREQ.
       COPY LIMITCTX.

       PROCEDURE DIVISION USING AUTH-REQUEST LIMIT-CONTEXT.
           MOVE LC-BASE-LIMIT TO WS-CANDIDATE-LIMIT

           IF LC-JURIS-LIMIT > 0
              AND LC-JURIS-LIMIT < WS-CANDIDATE-LIMIT
              MOVE LC-JURIS-LIMIT TO WS-CANDIDATE-LIMIT
           END-IF

           IF LC-MCC-LIMIT > 0
              AND LC-MCC-LIMIT < WS-CANDIDATE-LIMIT
              MOVE LC-MCC-LIMIT TO WS-CANDIDATE-LIMIT
           END-IF

           IF LC-TEMP-LIMIT > 0
              AND LC-TEMP-LIMIT < WS-CANDIDATE-LIMIT
              MOVE LC-TEMP-LIMIT TO WS-CANDIDATE-LIMIT
           END-IF

           IF LC-GRANDFATHERED = 'Y'
              MOVE LC-EXCEPTION-LIMIT TO WS-CANDIDATE-LIMIT
           ELSE
              IF LC-RISK-SCORE >= 800
                 COMPUTE WS-CANDIDATE-LIMIT = WS-CANDIDATE-LIMIT * 0.80
              ELSE
                 IF LC-RISK-SCORE < 500
                    COMPUTE WS-CANDIDATE-LIMIT = WS-CANDIDATE-LIMIT * 0.70
                 END-IF
              END-IF
           END-IF

           IF WS-CANDIDATE-LIMIT > LC-PRODUCT-MAX
              MOVE LC-PRODUCT-MAX TO WS-CANDIDATE-LIMIT
           END-IF

           MOVE WS-CANDIDATE-LIMIT TO LC-FINAL-LIMIT
           GOBACK.
